{
  "name": "web2md",
  "version": "0.2.0",
  "description": "Chrome extension that converts the current page (or selection) to Markdown and copies it for AI.",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "build": "node scripts/build.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "license": "MIT"
}
